# --- Resultados brutos pesados (se suben más adelante, con criterio) ---
resultados/*
!resultados/.gitkeep

# Capturas de paquetes (nunca al repo, demasiado pesadas)
*.pcap
*.pcapng

# Figuras generadas (se regeneran con graficar_comparativa.py)
figuras/*.png
figuras/*.pdf
!figuras/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/

# Sistema / editores
.DS_Store
*.swp
*~

# Comprimidos temporales
*.zip
*.tar.gz
