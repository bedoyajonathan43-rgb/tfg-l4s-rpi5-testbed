diff --git a/docker-compose/docker-compose-oai-rfsim-basic.yaml b/docker-compose/docker-compose-oai-rfsim-basic.yaml
index dcef01a..532566b 100644
--- a/docker-compose/docker-compose-oai-rfsim-basic.yaml
+++ b/docker-compose/docker-compose-oai-rfsim-basic.yaml
@@ -9,10 +9,17 @@ services:
         cap_drop:
             - ALL
         environment:
-            USE_ADDITIONAL_OPTIONS: -E --rfsim --MACRLCs.[0].stats_max_ue 0 --log_config.global_log_options level,nocolor,time
+            TFG_L4S_UMBRAL_US: ${TFG_L4S_UMBRAL_US:-0}
+            TFG_L4S_CTRL: /tmp/tfg_umbral
+            TFG_RLC_LOG: ${TFG_RLC_LOG:-/opt/oai-gnb/tfg_rlc.csv}
+            TFG_LOG_MS: ${TFG_LOG_MS:-10}
+            RFSIM_REALTIME: ${RFSIM_REALTIME:-0}
+            USE_ADDITIONAL_OPTIONS: -E --rfsim --MACRLCs.[0].stats_max_ue 1 --log_config.global_log_options level,nocolor,time ${RUIDO_OPTS_GNB:-}
             ASAN_OPTIONS: detect_leaks=0
         volumes:
+            - ./rfsim-rt/nr-softmodem-tfg:/opt/oai-gnb/bin/nr-softmodem
             - ./ran-conf/gnb.conf:/opt/oai-gnb/etc/gnb.conf
