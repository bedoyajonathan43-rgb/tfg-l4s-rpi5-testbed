+  modellist_tfg = (
+    {
+      model_name     = "rfsimu_channel_enB0";
+      type           = "AWGN";
+      ploss_dB       = 0;
+      noise_power_dB = -50;
+      forgetfact     = 0;
+      offset         = 0;
+      ds_tdl         = 0;
+    },
+    {
+      model_name     = "rfsimu_channel_ue0";
+      type           = "AWGN";
+      ploss_dB       = 0;
+      noise_power_dB = -50;
+      forgetfact     = 0;
+      offset         = 0;
+      ds_tdl         = 0;
+    }
+  );
+};
